_sync/
outputs/
*.tgz

# --- Never published ------------------------------------------------------
# The locked answer keys, blind sets and corpus: never committed, never pushed
# (a pre-push guard in .git/hooks refuses any push holding them, 15 Nov 2026).
/eval/

