  "assumptions": [
   {
    "id": "ASM_MATERIAL_PLA",
    "statement": "The part is 3D-printed in generic PLA filament, standard consumer grade, with typical FDM print settings (no specific infill, layer height, or orientation specified).",
    "risk": "low",
    "rationale": "The brief names the material as PLA but gives no grade, infill, or print settings; these do not affect checkable geometry since no load case applies.",
    "consequence_if_wrong": "A different PLA grade or print setting could change real-world strength, but this is not tested here since no load case was specified.",
    "reversible": true,
    "approved": false
   },
   {
    "id": "ASM_HOLE_THROUGH",
    "statement": "The 3.4 mm motor holes and 4.5 mm bolt-circle holes are through holes (not blind), consistent with the bore and counterbored holes also being through.",
    "risk": "low",
    "rationale": "The brief does not state depth for these holes other than the counterbore; through holes are the conventional choice for mounting/clearance holes in a plate.",
    "consequence_if_wrong": "If blind holes were intended, fasteners would not pass through and the mounting function would fail.",
    "reversible": true,
    "approved": false
   },
   {
    "id": "ASM_SLOT_DEPTH",
    "statement": "The two 20x5 mm slots pass fully through the plate thickness.",
    "risk": "low",
    "rationale": "The brief describes them as slots running along the plate's length without specifying depth; through-slots are the conventional interpretation for mounting/cable-routing slots.",
    "consequence_if_wrong": "If the slots were meant to be blind pockets, their function (adjustment or cable routing) would not be achieved.",
    "reversible": true,
    "approved": false
   },
   {
    "id": "ASM_COUNTERBORE_HEAD_FIT",
    "statement": "The 10 mm x 4 mm counterbore is assumed to be a generic recess for a socket-head or similar fastener head, without confirming a specific screw standard.",
