  "assumptions": [
   {
    "id": "ASM_LOFT_METHOD",
    "statement": "The loft between the five stated cross-sections is a smooth continuous loft (not a sequence of abrupt steps), consistent with normal loft modelling practice.",
    "rationale": "The brief calls it 'a loft through five rounded-rectangle cross-sections' which implies continuous surface, but does not state linear vs spline blending.",
    "consequence_if_wrong": "A different interpolation method would change the exact intermediate silhouette, though all stated stations would still measure correctly.",
    "risk": "moderate",
    "reversible": true,
    "approved": false
   },
   {
    "id": "ASM_PLA_PRINT_SETTINGS",
    "statement": "Standard FDM PLA print practice (ordinary infill, no specified minimum overhang angle or support strategy) is assumed adequate for this geometry; no specific print orientation is mandated.",
