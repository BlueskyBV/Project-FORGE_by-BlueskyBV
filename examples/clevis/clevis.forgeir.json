      "threshold": {
        "magnitude": 3.0,
        "unit": "mm"
      },
      "comparison": "at_least",
      "source": "derived",
      "state": "not_tested",
      "measurement": "minimum_wall_thickness"
    },
    {
      "id": "REQ_MASS_BUDGET",
      "statement": "The clevis body should weigh no more than 40 g in 6061-T6.",
