        "magnitude": 8.2,
        "unit": "mm"
      },
      "comparison": "equals",
      "source": "user",
      "state": "accepted",
      "measurement": "interface_size:pivot_port"
    },
    {
      "id": "REQ_MIN_WALL",
      "statement": "No wall may be thinner than 3 mm, for the CNC aluminium scenario.",
